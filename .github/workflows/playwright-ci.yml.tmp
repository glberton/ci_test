name: Playwright CI

on:
    push:
        branches: [ main ]
    pull_request:
        branches: [ main ]

jobs:
    testes_playwright:
        name: Testes Playwright
        runs-on: ubuntu-latest
        container:
            image: mcr.microsoft.com/playwright/python:v1.64.1
            # options: --user 1001
        
        steps:
            - name: Baixar código do repositório
              uses: actions/checkout@v6
            
            # - name: Configurar Python 3.13
            #   uses: actions/setup-python@v7
            #   with:
            #       python-version: '3.13'
            
            - name: Instalar dependências do Python
              run: |
                  python -m pip install --upgrade pip
                  pip install -r requirements.txt
            
            - name: Executar testes do Playwright
              run: |
                  pytest --headless
